{
  "package_format": "tin-workflow-package-v1",
  "definition": {
    "key": "growth.buyer_trust",
    "title": "Check if buyers trust this checkout",
    "description": "A founder runs this before launch or after a signup QA to learn whether a skeptical buyer would trust the site and checkout, and gets a ranked trust report with exact next fixes. Safe public checks only; not a CVE pentest.",
    "version": "1.0.0",
    "executor": "codex.procedure",
    "schedule_modes": ["on_demand"],
    "human_review": {
      "eligible": true,
      "reason": "Produces externally visible trust claims and ranked fixes.",
      "review_label": "Review trust report",
      "defer_label": "Not now",
      "summary": "Review the buyer-trust report before acting on its fixes.",
      "queue_clause": "Buyer-trust report ready to review"
    },
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {"type": "string", "format": "uuid"},
        "site_url": {
          "type": "string",
          "format": "uri",
          "minLength": 10,
          "maxLength": 500,
          "title": "Public website",
          "description": "Exact HTTPS origin without a path or query.",
          "x-tin-ui": {"control": "text", "order": 10}
        },
        "depth": {
          "type": "string",
          "enum": ["focused", "standard", "extensive"],
          "default": "standard",
          "title": "Depth",
          "x-tin-ui": {"control": "select", "order": 20}
        },
        "notes": {
          "type": "string",
          "maxLength": 2000,
          "default": "",
          "title": "Anything to check?",
          "description": "Checkout quirks, known constraints, or areas a stranger would not know. Never credentials.",
          "x-tin-ui": {"control": "textarea", "order": 30}
        }
      },
      "required": ["project_id", "site_url"]
    },
    "prerequisites": [
      {
        "kind": "run",
        "level": "recommended",
        "workflow": "qa.signup_walkthrough",
        "reason": "The newest signup report gives the signup path and walls the trust audit checks."
      },
      {
        "kind": "artifact",
        "level": "recommended",
        "path": "wiki/INDEX.md",
        "section": "### Feature map",
        "producer": "product.deep_dive",
        "reason": "The Feature map grounds checkout claims; without it the audit uses page text only."
      }
    ],
    "procedure": {
      "prompt_path": "PROMPT.md",
      "skills_path": "skills",
      "skill_files": ["skills/buyer-trust/SKILL.md", "skills/buyer-trust/playbook.md"],
      "entry_skill": "buyer-trust",
      "workspace": {"kind": "project.state"},
      "sandbox": {"profile": "isolated", "egress": "fenced", "timeout_seconds": 900},
      "output": {
        "kind": "project.artifact",
        "path": "reports/BUYER_TRUST.md",
        "media_type": "text/markdown",
        "max_bytes": 32000
      }
    }
  }
}
